# Every value blank: blank is right for local work with the mock (MOCK=1 pnpm dev).
# Copy to .env.local (git ignores it) only to point the dev server somewhere else. Never put a secret here.

# 1: every /api/v1 call goes to the local Prism mock (pnpm mock).
MOCK=
# Where the mock listens (default http://127.0.0.1:4010).
MOCK_ORIGIN=
# Without MOCK: where this app's server calls the API. In development /api/v1 is also rewritten to it (for staging,
# from Phase 3b: the staging proxy's one-origin mode, http://127.0.0.1:3200). In production the load balancer routes
# /api/* for the browser, and this address is still open (decided in Phase 3).
API_ORIGIN=
# The site's own origin, sent as Origin on a POST made while rendering on this server.
SITE_ORIGIN=
# metadata: this app's server sends a Google ID token (from the Cloud Run metadata server) to API_ORIGIN. Set only on
# frontend-staging by the backend's deploy/20-frontend-staging.sh; leave blank on your laptop.
API_ID_TOKEN=
