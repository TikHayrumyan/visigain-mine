{
  "name": "visigain-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/tokens-build.mjs --check && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens": "node scripts/tokens-build.mjs"
  },
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "clsx": "^2.1.1",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "swiper": "^14.4.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.28",
    "prettier": "3.9.10",
    "tailwindcss": "4",
    "tsx": "^4.23.15",
    "typescript": "5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@8.10.5"
