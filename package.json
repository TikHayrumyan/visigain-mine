{
  "name": "visigain-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "mock": "prism mock api/openapi.yaml --host 127.0.0.1 --port 4010 --dynamic=false",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/tokens-build.mjs --check && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "tokens": "node scripts/tokens-build.mjs",
    "api:sync": "node scripts/api-sync.mjs"
  },
  "dependencies": {
    "@fontsource/poppins": "5.3.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@stoplight/prism-cli": "5.16.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-react": "7.37.5",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.28",
    "prettier": "3.9.10",
    "tailwindcss": "4",
    "tsx": "^4.23.15",
    "typescript": "5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@8.10.5"
}
